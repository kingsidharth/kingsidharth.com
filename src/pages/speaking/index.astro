---
import { getCollection } from 'astro:content';
import PageArtwork from '@/components/PageArtwork.astro';
import Base from '@/layouts/Base.astro';
import { splitId } from '@/lib/content';
import { formatDate } from '@/lib/i18n';
const talks = (await getCollection('speaking', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base locale="en" title="Speaking" description="Talks, workshops, and conversations on design, startups, and building a career." path="speaking">
  <PageArtwork title="Speaking" kind="speaking" />
  <main class="mx-auto max-w-3xl px-(--spacing-gutter) py-14">
    <ul>
      {talks.map(talk => <li class="border-b border-rule py-5">
        <p class="nameplate mb-2"><time datetime={talk.data.pubDate.toISOString()}>{formatDate(talk.data.pubDate, 'en')}</time></p>
        <a class="block py-2 text-xl font-bold hover:text-primary" href={`/speaking/${splitId(talk.id).slug}`}>{talk.data.title}</a>
        <p class="text-muted-foreground">{talk.data.description}</p>
      </li>)}
    </ul>
  </main>
</Base>
