---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import InstrumentCard from '@/components/InstrumentCard.astro';
import BroadcastCard from '@/components/BroadcastCard.astro';
import NoteRow from '@/components/NoteRow.astro';
import TemperatureInstrument from '@/components/instruments/TemperatureInstrument';
import GotchaQuiz from '@/components/instruments/GotchaQuiz';
import { getLocalized } from '@/lib/content';
import { localePath, localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const instruments = (await getCollection('instruments')).sort(
  (a, b) => a.data.figure - b.data.figure
);
const broadcasts = (await getCollection('broadcasts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const notes = (await getLocalized('blog', locale)).slice(0, 5);
---

<Base
  locale={locale}
  title="Sidharth — Product builder"
  description="Building tools to understand AI. Essays, interactive demos, and videos from Bengaluru."
  bareTitle
>
  <!-- ── Who this is ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-14 sm:pt-20">
    <p class="nameplate mb-5 text-primary">Bengaluru</p>

    <h1 class="text-4xl sm:text-5xl">I'm Sidharth. I:</h1>

    <ul class="mt-6 max-w-[36ch] space-y-2 text-xl sm:text-2xl">
      {
        [
          'Build products',
          'Teach AI to engineers and non-coders',
          'Read research papers',
          'Build visualisation and teaching tools',
          'Help startups',
        ].map((item) => (
          <li class="flex gap-3">
            <span class="mt-[0.6em] h-px w-4 shrink-0 bg-primary" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-[56ch] text-muted-foreground">
      16+ years working with startups. Currently at Outskill; before that Headout, Instamojo and
      more. I also run a <a href="https://youtube.com/@kingsidharth" class="text-primary hover:underline">YouTube channel</a>.
    </p>
  </section>

  <!-- ── Featured demo. One of the tools, not the premise of the
         site — hence its own section below the introduction. ───── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-14 sm:pt-16">
    <p class="nameplate mb-3 text-primary">One of the teaching tools</p>

    <h2 class="max-w-[24ch] text-2xl sm:text-3xl">Temperature visualiser</h2>

    <p class="mt-4 max-w-[58ch] text-muted-foreground">
      Before you look at it — a question most people get wrong.
    </p>

    <div class="mt-7 max-w-2xl">
      <GotchaQuiz client:visible />
    </div>

    <!-- Revealed by the quiz. Hidden rather than un-rendered so the
         reveal is instant and it stays out of the a11y tree until
         then. Note `client:idle` below, NOT `client:visible`: a
         `hidden` element has no layout, so an IntersectionObserver
         never fires and the island would still be inert after the
         reveal. -->
    <div id="instrument-reveal" hidden class="mt-10">
      <p class="mt-4 mb-7 max-w-[58ch] text-muted-foreground">
        Same knob, three prompts. Turn it up and the poem gets more interesting while the
        arithmetic starts getting the answer wrong. Switch to greedy and the maths is safe at any
        temperature — but the poem says "star" every single time.
      </p>
      <TemperatureInstrument client:idle />
    </div>
  </section>

  <script>
    // The quiz island dispatches this once, on first answer or reveal.
    document.addEventListener('gotcha:revealed', () => {
      const panel = document.getElementById('instrument-reveal');
      if (!panel) return;
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>

  <!-- ── The shelf ────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead
      title={t('shelf.title')}
      sub={`${instruments.length} ${t('shelf.sub')}`}
      glyph="shelf"
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {instruments.map((entry) => <InstrumentCard entry={entry} locale={locale} />)}
    </div>

    <!-- The board the units stand on. Purely scenographic. -->
    <div
      class="mt-8 h-3.5 rounded-xs bg-linear-to-b from-chassis-hi via-chassis-lo to-chassis-edge shadow-[inset_0_1px_0_rgb(255_255_255/0.14),0_8px_20px_rgb(0_0_0/0.25)]"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- ── Broadcasts ───────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('broadcasts.title')} sub={t('broadcasts.sub')} glyph="reel" />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {broadcasts.map((entry) => <BroadcastCard entry={entry} locale={locale} />)}
    </div>
  </section>

  <!-- ── Field notes ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('notes.title')} sub={t('notes.sub')} glyph="note" />

    <div class="max-w-3xl">
      {notes.map((entry) => <NoteRow entry={entry} locale={locale} />)}

      <p class="mt-5 font-mono text-xs text-muted-foreground">
        <a href={localePath(locale, 'blog')} class="text-primary hover:underline">
          {t('notes.all')} →
        </a>
      </p>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <p class="max-w-[32ch] text-3xl">Product builder, Bengaluru.</p>
    <p class="mt-4 max-w-[50ch] text-muted-foreground">
      About 16 years working on products. Founding team at Instamojo, then Headout, now at
      Outskill. These tools and essays are for anyone trying to understand how AI actually works.
    </p>
  </section>
</Base>
