---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import BroadcastCard from '@/components/BroadcastCard.astro';
import NoteRow from '@/components/NoteRow.astro';
import WorkList from '@/components/WorkList.astro';
import TemperatureInstrument from '@/components/instruments/TemperatureInstrument';
import GotchaQuiz from '@/components/instruments/GotchaQuiz';
import HeroIntro from '@/components/HeroIntro.astro';
import TeachingStats from '@/components/TeachingStats.astro';
import ToolsBento from '@/components/ToolsBento.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import PromptsToSteal from '@/components/PromptsToSteal';
import { getLocalized } from '@/lib/content';
import { localePath, localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const instruments = (await getCollection('instruments')).sort(
  (a, b) => a.data.figure - b.data.figure
);
const broadcasts = (await getCollection('broadcasts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const notes = (await getLocalized('blog', locale)).slice(0, 5);

---

<Base
  locale={locale}
  title="Sidharth — Product builder"
  description="Product builder in Bengaluru. Tools, writing and videos about how AI actually behaves."
  bareTitle
>
  <!-- ── Hero. Two columns on desktop: the introduction on the left,
         and Teaching + Challenge as one attached instrument on the
         right — vertically middle-aligned against the intro rather
         than top-aligned, which is what makes them read as a pair. ── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-12 sm:pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16">
      <HeroIntro />

      <div class="chassis relative w-full">
        <span aria-hidden="true" class="screw absolute left-2.5 top-2.5"></span>
        <span aria-hidden="true" class="screw absolute right-2.5 top-2.5"></span>
        <span aria-hidden="true" class="screw absolute bottom-2.5 left-2.5"></span>
        <span aria-hidden="true" class="screw absolute bottom-2.5 right-2.5"></span>

        <TeachingStats />
        <div class="panel-divider-h"></div>
        <GotchaQuiz embedded client:visible />
      </div>
    </div>
  </section>

  <!-- Revealed by the quiz. Hidden rather than un-rendered so the
       reveal is instant and it stays out of the a11y tree until then.
       Note `client:idle`, NOT `client:visible`: a `hidden` element has
       no layout, so an IntersectionObserver never fires and the island
       would still be inert after the reveal. -->
  <section
    id="instrument-reveal"
    hidden
    class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-16"
  >
    <p class="nameplate mb-3 text-primary">One of the teaching tools</p>
    <h2 class="max-w-[24ch] text-2xl sm:text-3xl">Temperature visualiser</h2>
    <p class="mt-4 mb-8 max-w-[58ch] text-muted-foreground">
      Same knob, three prompts. Turn it up and the poem gets more interesting while the arithmetic
      starts getting the answer wrong. Switch to greedy and the maths is safe at any temperature —
      but the poem says "star" every single time.
    </p>
    <TemperatureInstrument client:idle />
  </section>

  <script>
    // The quiz island dispatches this once, on first answer or reveal.
    document.addEventListener('gotcha:revealed', () => {
      const panel = document.getElementById('instrument-reveal');
      if (!panel) return;
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>

  <!-- ── Work, with prompts to steal alongside it. Teaching + the
         challenge now live in the hero, attached as one unit. ────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16">
      <div>
        <SectionHead title={t('work.title')} />
        <WorkList entries={work} />
        <p class="mt-6 font-mono text-xs">
          <a href={localePath(locale, 'work')} class="text-primary hover:underline">
            More about the work →
          </a>
        </p>
      </div>

      <div class="lg:sticky lg:top-24">
        <PromptsToSteal client:visible />
      </div>
    </div>
  </section>

  <!-- ── Tools & Experiments, as an asymmetric bento rather than a
         uniform grid — Temperature is the flagship. ───────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('shelf.title')} />

    <ToolsBento entries={instruments} locale={locale} />
  </section>

  <!-- ── Watch ────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('broadcasts.title')} />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {broadcasts.map((entry) => <BroadcastCard entry={entry} locale={locale} />)}
    </div>
  </section>

  <!-- ── Elsewhere. Sits after the videos because that is where a
         reader who liked something goes looking for more of it. ─── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pb-4">
    <div class="chassis relative flex flex-wrap items-center justify-between gap-6 p-6">
      <span class="screw top-2.5 left-2.5"></span>
      <span class="screw top-2.5 right-2.5"></span>
      <span class="screw bottom-2.5 left-2.5"></span>
      <span class="screw bottom-2.5 right-2.5"></span>

      <div>
        <p class="nameplate">Elsewhere</p>
        <p class="mt-1.5 text-sm text-muted-foreground">
          More of the same, on other people's platforms.
        </p>
      </div>

      <SocialLinks variant="tile" class="max-w-[22rem] flex-1" />
    </div>
  </section>

  <!-- ── Notes ────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('notes.title')} />

    <div class="max-w-3xl">
      {notes.map((entry) => <NoteRow entry={entry} locale={locale} />)}

      <p class="mt-5 font-mono text-xs text-muted-foreground">
        <a href={localePath(locale, 'blog')} class="text-primary hover:underline">
          {t('notes.all')} →
        </a>
      </p>
    </div>
  </section>
</Base>
