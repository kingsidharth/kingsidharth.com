---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import InstrumentCard from '@/components/InstrumentCard.astro';
import BroadcastCard from '@/components/BroadcastCard.astro';
import NoteRow from '@/components/NoteRow.astro';
import TemperatureInstrument from '@/components/instruments/TemperatureInstrument';
import { getLocalized } from '@/lib/content';
import { localePath, localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const instruments = (await getCollection('instruments')).sort(
  (a, b) => a.data.figure - b.data.figure
);
const broadcasts = (await getCollection('broadcasts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
const notes = (await getLocalized('blog', locale)).slice(0, 5);
---

<Base
  locale={locale}
  title="Sidharth — Product builder"
  description="Building tools to understand AI. Essays, interactive demos, and videos from Bengaluru."
  bareTitle
>
  <!-- ── Who this is ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-14 sm:pt-20">
    <p class="nameplate mb-5 text-primary">Bengaluru · product &amp; design</p>

    <h1 class="max-w-[24ch] text-4xl sm:text-5xl">
      I'm Sidharth. I build products, and tools that show how AI actually behaves.
    </h1>

    <p class="mt-6 max-w-[54ch] text-lg text-muted-foreground">
      Sixteen years in product and design — founding team at Instamojo, then Headout, now
      Outskill. I write about AI and build small tools you can take apart.
    </p>
  </section>

  <!-- ── Featured demo. One of the tools, not the premise of the
         site — hence its own section below the introduction. ───── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pt-14 sm:pt-16">
    <p class="nameplate mb-3 text-primary">Featured · sampling</p>

    <h2 class="max-w-[20ch] text-2xl sm:text-3xl">What temperature actually does</h2>

    <p class="mt-4 max-w-[54ch] text-muted-foreground">
      Temperature means nothing without the sampling strategy. Turn the knob and watch top-k and
      top-p disagree about the same distribution.
    </p>

    <div class="mt-9">
      <TemperatureInstrument client:visible />
    </div>
  </section>

  <!-- ── The shelf ────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead
      title={t('shelf.title')}
      sub={`${instruments.length} ${t('shelf.sub')}`}
      glyph="shelf"
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {instruments.map((entry) => <InstrumentCard entry={entry} locale={locale} />)}
    </div>

    <!-- The board the units stand on. Purely scenographic. -->
    <div
      class="mt-8 h-3.5 rounded-xs bg-linear-to-b from-chassis-hi via-chassis-lo to-chassis-edge shadow-[inset_0_1px_0_rgb(255_255_255/0.14),0_8px_20px_rgb(0_0_0/0.25)]"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- ── Broadcasts ───────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('broadcasts.title')} sub={t('broadcasts.sub')} glyph="reel" />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {broadcasts.map((entry) => <BroadcastCard entry={entry} locale={locale} />)}
    </div>
  </section>

  <!-- ── Field notes ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <SectionHead title={t('notes.title')} sub={t('notes.sub')} glyph="note" />

    <div class="max-w-3xl">
      {notes.map((entry) => <NoteRow entry={entry} locale={locale} />)}

      <p class="mt-5 font-mono text-xs text-muted-foreground">
        <a href={localePath(locale, 'blog')} class="text-primary hover:underline">
          {t('notes.all')} →
        </a>
      </p>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-16 sm:py-20">
    <p class="max-w-[32ch] text-3xl">Product builder, Bengaluru.</p>
    <p class="mt-4 max-w-[50ch] text-muted-foreground">
      About 16 years working on products. Founding team at Instamojo, then Headout, now at
      Outskill. These tools and essays are for anyone trying to understand how AI actually works.
    </p>
  </section>
</Base>
