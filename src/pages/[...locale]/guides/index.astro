---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import JourneyHero from '@/components/JourneyHero.astro';
import GuideCard from '@/components/GuideCard.astro';
import { getGuides } from '@/lib/content';
import { formatDate, localePath, localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const guides = await getGuides(locale);
---

<Base
  locale={locale}
  title={t('guides.title')}
  description="Long explanations, read in order. The stuff too big for a note."
  path="guides"
>
  <!-- The index gets the same cover treatment as the guides themselves,
       on the black hole. It is the one artwork in the set that is not
       about a single subject — a bright field with a hole in it — which
       suits a page that is a way in to several things rather than a
       thing itself. -->
  <header
    class="relative isolate flex min-h-[max(30rem,84svh)] flex-col justify-start overflow-hidden pt-32 pb-14"
  >
    <JourneyHero />
    <div class="relative mx-auto w-full max-w-(--container-wide) px-(--spacing-gutter)">
      <h1 class="pixel-type text-3xl sm:text-4xl lg:text-5xl">{t('guides.title')}</h1>
    </div>
  </header>

  <div class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) pb-20">
    <ul class="card-grid">
      {
        guides.map((guide, i) => (
          <li>
            <GuideCard
              href={localePath(locale, `guides/${guide.slug}`)}
              title={guide.root.data.title}
              art={guide.root.data.art}
              meta={
                guide.chapters.length > 0
                  ? `${guide.chapters.length + 1} ${t('guides.parts')}`
                  : formatDate(guide.root.data.pubDate, locale, { day: undefined })
              }
              index={i}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Base>
