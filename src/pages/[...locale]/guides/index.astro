---
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import JourneyHero from '@/components/JourneyHero.astro';
import GuideCard from '@/components/GuideCard.astro';
import { getGuides } from '@/lib/content';
import { formatDate, localePath, localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const guides = await getGuides(locale);
const parts = guides.reduce((n, g) => n + g.chapters.length + 1, 0);
---

<Base
  locale={locale}
  title={t('guides.title')}
  description="Long explanations, read in order. The stuff too big for a note."
  path="guides"
>
  <!-- The journey: a walker on a path toward a distant light. The title
       block sits low left, where the artwork leaves the dark, and the
       cards start inside the hero's lower edge so the walker's path
       runs down into them. -->
  <header
    class="guide-index-hero relative isolate flex min-h-[max(28rem,72svh)] flex-col justify-end overflow-hidden pt-32 pb-28 sm:pb-36"
  >
    <JourneyHero />
    <div class="relative mx-auto w-full max-w-(--container-wide) px-(--spacing-gutter)">
      <p class="nameplate mb-3 text-[var(--hue-500)]">
        {guides.length} {t('guides.title').toLowerCase()} · {parts} {t('guides.parts')} · {t('guides.sub')}
      </p>
      <h1 class="pixel-type text-4xl sm:text-5xl">{t('guides.title')}</h1>
      <p class="mt-4 max-w-[44ch] text-base text-white/70 sm:text-lg">
        Long explanations, read in order. Each one is the thing too big for a note, with the
        machine on screen while you read about it.
      </p>
    </div>
  </header>

  <!-- Pulled up over the hero's foot: the cards belong to the picture,
       not to the page under it. -->
  <div class="relative z-10 mx-auto -mt-20 max-w-(--container-wide) px-(--spacing-gutter) pb-20 sm:-mt-24">
    <ul class="card-grid">
      {
        guides.map((guide, i) => (
          <li data-arrive style={`--arrive-i:${i}`}>
            <GuideCard
              href={localePath(locale, `guides/${guide.slug}`)}
              title={guide.root.data.title}
              art={guide.root.data.art}
              meta={
                guide.chapters.length > 0
                  ? `${guide.chapters.length + 1} ${t('guides.parts')}`
                  : formatDate(guide.root.data.pubDate, locale, { day: undefined })
              }
              index={i}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .guide-index-hero {
    background: #101218;
    color: #f3f1eb;
  }
</style>
