---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import BroadcastCard from '@/components/BroadcastCard.astro';
import { localeStaticPaths, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const broadcasts = (await getCollection('broadcasts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  locale={locale}
  title={t('broadcasts.title')}
  description="Long-form demonstrations. One every Friday."
  path="broadcasts"
>
  <div class="mx-auto max-w-(--container-wide) px-(--spacing-gutter) py-14">
    <SectionHead title={t('broadcasts.title')} as="h1" />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {broadcasts.map((entry) => <BroadcastCard entry={entry} locale={locale} />)}
    </div>
  </div>
</Base>
