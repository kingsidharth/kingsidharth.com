---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<ul class="max-w-3xl">
  {
    entries.map((entry) => (
      <li class="flex flex-col gap-1 border-b border-rule py-5 sm:flex-row sm:gap-6">
        <div class="flex items-center gap-2.5 sm:w-52 sm:shrink-0">
          {/* Green pip for a current engagement, dim for a past one. */}
          <span
            class:list={[
              'size-1.5 shrink-0 rounded-full',
              entry.data.current
                ? 'bg-success shadow-[0_0_7px_var(--color-success)]'
                : 'bg-muted-foreground/40',
            ]}
            aria-hidden="true"
          />
          <span class="font-semibold">{entry.data.org}</span>
        </div>

        <div class="min-w-0 flex-1">
          <p class="flex flex-wrap items-baseline gap-x-3">
            <span>{entry.data.role}</span>
            <span class="nameplate">{entry.data.period}</span>
          </p>
          <p class="mt-1 text-sm text-muted-foreground">{entry.data.summary}</p>
        </div>
      </li>
    ))
  }
</ul>
