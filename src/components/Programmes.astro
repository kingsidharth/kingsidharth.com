---
/**
 * Each programme is its own small screen — a bank of displays you can
 * press, under the teaching readout in the same panel.
 *
 * The faces are kaomoji rather than drawn ASCII: they read at a glance
 * at this size, where box-drawing art turned to mush. Frames ship as
 * one JSON attribute per card; as individual `data-*` attributes the
 * quotes and backslashes in the old art arrived empty.
 */
const programmes = [
  {
    // Peeking from behind the wall — the "secret" is the joke.
    name: 'Steal the Secret Prompts',
    href: '#',
    bg: 'oklch(0.28 0.11 275)',
    ink: 'oklch(0.88 0.16 195)',
    shadow: 'oklch(0.18 0.09 275)',
    frames: {
      idle: ['┬┴┬┴┤ω・)', '┬┴┬┴┤・ω・)'],
      hover: '┬┴┬┴┤◕ω◕)ﾉ',
      click: '(๏ᆺ๏ )ノ',
    },
  },
  {
    // Clicks escalate rather than repeat: mild flip, angry flip, furious
    // flip, then it puts the table back and calms down. Anyone who
    // clicks twice gets rewarded for it.
    name: 'Vibe Coding 101',
    href: '#',
    bg: 'oklch(0.3 0.13 340)',
    ink: 'oklch(0.9 0.16 95)',
    shadow: 'oklch(0.19 0.1 340)',
    frames: {
      idle: ['(◑‿◐)'],
      hover: '(◑‿◐)♪',
      escalate: ['(ノ￣□￣)ノ ~┻━┻', '(ノಠ益ಠ)ノ彡┻━┻', '(┛◉Д◉)┛彡┻━┻'],
      recover: '┬─┬ノ( º _ ºノ)',
    },
  },
  {
    name: 'Deep AI',
    href: '#',
    bg: 'oklch(0.27 0.09 195)',
    ink: 'oklch(0.88 0.19 145)',
    shadow: 'oklch(0.17 0.07 195)',
    frames: { idle: ['(´⊙ω⊙`)！'], hover: 'ಥ‿ಥ', click: '(⊙_⊙;)' },
  },
  {
    name: 'Fun AI',
    href: '#',
    bg: 'oklch(0.32 0.12 45)',
    ink: 'oklch(0.92 0.15 85)',
    shadow: 'oklch(0.2 0.09 45)',
    frames: {
      idle: ['(ﾐⓛᆽⓛﾐ)✧', '(=^ ◡ ^=)', '(=◉ᆽ◉=)'],
      hover: '/ᐠ｡ꞈ｡ᐟ',
      click: '(=^･ω･^=)',
    },
  },
];
---

<div class="grid grid-cols-2 gap-3 p-5 pt-0 sm:p-6 sm:pt-0">
  {
    programmes.map((p) => (
      <a
        href={p.href}
        data-face-card
        class="screen-raised group flex flex-col items-center justify-center gap-3 px-3 py-5"
        style={`background:${p.bg}; --sprite-shadow:${p.shadow};`}
      >
        <span
          data-face
          data-frames={JSON.stringify(p.frames)}
          class="sprite-text block text-center text-xl"
          style={`color:${p.ink};`}
          aria-hidden="true"
        >
          {p.frames.idle[0]}
        </span>

        <span
          class="sprite-text text-center font-mono text-[11px]"
          style={`color:${p.ink};`}
        >
          {p.name}
        </span>
      </a>
    ))
  }
</div>

<script>
  interface Frames {
    idle?: string[];
    hover?: string;
    click?: string;
    /** Successive clicks walk this list before recovering. */
    escalate?: string[];
    recover?: string;
  }

  // One driver for every card. Idle cycling is skipped under reduced
  // motion, but hover and click still respond — those are user-initiated,
  // so suppressing them would just make the cards feel broken.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const card of document.querySelectorAll<HTMLElement>('[data-face-card]')) {
    const face = card.querySelector<HTMLElement>('[data-face]');
    if (!face) continue;

    const frames = JSON.parse(face.dataset.frames ?? '{}') as Frames;
    const idle = frames.idle?.length ? frames.idle : [face.textContent ?? ''];
    const hover = frames.hover ?? idle[0];
    const click = frames.click ?? idle[0];

    let tick = 0;
    let hovering = false;
    let reacting = false;
    let reactTimer: ReturnType<typeof setTimeout> | null = null;

    const render = () => {
      if (reacting) return;
      face.textContent = hovering ? hover : idle[tick % idle.length];
    };

    if (!reduce && idle.length > 1) {
      setInterval(() => {
        tick += 1;
        render();
      }, 800);
    }

    card.addEventListener('mouseenter', () => {
      hovering = true;
      render();
    });

    card.addEventListener('mouseleave', () => {
      hovering = false;
      render();
    });

    // No preventDefault — the link must still navigate once these have
    // real destinations.
    const escalate = frames.escalate ?? [];
    const recover = frames.recover;
    let rage = 0;

    card.addEventListener('click', () => {
      reacting = true;
      if (reactTimer) clearTimeout(reactTimer);

      if (escalate.length === 0) {
        face.textContent = click;
        reactTimer = setTimeout(() => {
          reacting = false;
          render();
        }, 900);
        return;
      }

      if (rage < escalate.length) {
        face.textContent = escalate[rage];
        rage += 1;
        // Hold the last rung longer, then set the table back up.
        const last = rage >= escalate.length;
        reactTimer = setTimeout(
          () => {
            if (last && recover) {
              face.textContent = recover;
              reactTimer = setTimeout(() => {
                rage = 0;
                reacting = false;
                render();
              }, 1100);
            } else {
              reacting = false;
              render();
            }
          },
          last ? 900 : 1400,
        );
      }
    });
  }
</script>
