---
/**
 * Each programme is its own small screen — a bank of displays you can
 * press, under the teaching readout in the same panel.
 *
 * The faces are kaomoji rather than drawn ASCII: they read at a glance
 * at this size, where box-drawing art turned to mush. Frames ship as
 * one JSON attribute per card; as individual `data-*` attributes the
 * quotes and backslashes in the old art arrived empty.
 */
const programmes = [
  {
    // Peeking from behind a wall, then leaning further out with each
    // nudge until it makes off with the goods.
    name: 'Steal the Secret Prompts',
    href: '#prompts',
    bg: 'oklch(0.28 0.11 275)',
    ink: 'oklch(0.88 0.16 195)',
    shadow: 'oklch(0.16 0.09 275)',
    labelBg: 'oklch(0.78 0.13 190)',
    labelInk: 'oklch(0.22 0.07 220)',
    title: 'marquee',
    frames: {
      idle: ['┬┴┬┴┤ω・)', '┬┴┬┴┤・ω・)'],
      l1: '┬┴┬┤ ͡° ͜ʖ ͡°)',
      l2: '┤ ͡° ͜ʖ ͡°)ノ⌐■-■',
      l3: '(⌐■_■)ﾉ♨ ┬┴┬┴',
      recover: '┬┴┬┴┤・_・)',
    },
  },
  {
    name: 'Vibe Coding 101',
    href: '/guides/vibe-coding/101',
    bg: 'oklch(0.3 0.13 340)',
    ink: 'oklch(0.98 0 0)',
    shadow: 'oklch(0.19 0.1 340)',
    title: 'wordmark',
    frames: {
      idle: ['(◑‿◐)'],
      l1: '(◑‿◐)♪',
      l2: '(ノ￣□￣)ノ ~┻━┻',
      l3: '(┛◉Д◉)┛彡┻━┻',
      recover: '┬─┬ノ( º _ ºノ)',
    },
  },
  {
    // Sinking deeper with each interaction.
    name: 'Deep AI',
    href: '/guides',
    bg: 'oklch(0.27 0.09 195)',
    ink: 'oklch(0.88 0.19 145)',
    shadow: 'oklch(0.15 0.07 195)',
    title: 'extruded',
    frames: {
      idle: ['≋ (´⊙ω⊙`) ≋', '≋≋ (´⊙ω⊙`) ≋'],
      l1: '≋ (っ´⊙ω⊙)っ',
      l2: '≋ ( ⊙_⊙;) ≋',
      l3: '≋≋ ( ×_×) ≋≋',
      recover: '≋ ( ˘ω˘ ) ≋',
    },
  },
  {
    name: 'Fun AI',
    href: '/instruments',
    bg: 'oklch(0.32 0.12 45)',
    ink: 'oklch(0.92 0.15 85)',
    shadow: 'oklch(0.2 0.09 45)',
    title: 'sprite',
    symbols: '✦ ✧ ★ ☆ ✿ ❀ ♪ ✦ ✧ ★ ☆ ✿ ❀ ♪ ',
    frames: {
      idle: ['(ﾐⓛᆽⓛﾐ)✧', '(=^ ◡ ^=)', '(=◉ᆽ◉=)'],
      l1: '/ᐠ｡ꞈ｡ᐟ\\',
      l2: '(=^･ω･^=)ﾉ',
      l3: '＼(=^▽^=)／',
      recover: '(=˘ᆽ˘=)',
    },
  },
];
---

<div class="grid grid-cols-2 gap-3 p-5 pt-0 sm:p-6 sm:pt-0">
  {
    programmes.map((p) => (
      <a
        href={p.href}
        data-face-card
        class="screen-raised group relative flex h-full flex-col items-center justify-center gap-3 px-3 py-5 saturate-[0.55] transition-[filter] duration-300 hover:saturate-100 focus-visible:saturate-100 active:saturate-150"
        style={`background:${p.bg}; --sprite-shadow:${p.shadow};`}
      >
        {
          p.symbols && (
            <span
              class="symbol-drift pointer-events-none absolute inset-x-0 top-2 overflow-hidden text-center text-[11px] opacity-50"
              style={`color:${p.ink};`}
              aria-hidden="true"
            >
              <span>{p.symbols.repeat(2)}</span>
            </span>
          )
        }

        <span
          data-face
          data-frames={JSON.stringify(p.frames)}
          class="sprite-text block whitespace-nowrap text-center text-xl"
          style={`color:${p.ink};`}
          aria-hidden="true"
        >
          {p.frames.idle[0]}
        </span>

        {
          p.title === 'marquee' ? (
            /* A printed plate rather than bare text: brighter ground,
               darker ink, so the scrolling title reads as a label stuck
               on the cartridge. */
            <span
              class="label-marquee w-full rounded-sm py-1"
              style={`background:${p.labelBg}; color:${p.labelInk};`}
            >
              <span class="font-mono text-[11px] font-semibold">
                {`${p.name}\u00a0\u00a0·\u00a0\u00a0`.repeat(4)}
              </span>
            </span>
          ) : p.title === 'extruded' ? (
            <span
              class="text-extruded text-center font-mono text-[13px] font-bold"
              style={`color:${p.ink};`}
            >
              {p.name}
            </span>
          ) : p.title === 'wordmark' ? (
            <span
              class="sprite-text text-center font-mono text-[13px] font-bold"
              style={`color:${p.ink};`}
            >
              {p.name}
            </span>
          ) : (
            <span class="sprite-text text-center font-mono text-[11px]" style={`color:${p.ink};`}>
              {p.name}
            </span>
          )
        }
      </a>
    ))
  }
</div>

<script>
  interface Frames {
    idle?: string[];
    /** Escalation rungs: hover reaches l1, each click advances one more. */
    l1?: string;
    l2?: string;
    l3?: string;
    recover?: string;
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const card of document.querySelectorAll<HTMLElement>('[data-face-card]')) {
    const face = card.querySelector<HTMLElement>('[data-face]');
    if (!face) continue;

    const frames = JSON.parse(face.dataset.frames ?? '{}') as Frames;
    const idle = frames.idle?.length ? frames.idle : [face.textContent?.trim() ?? ''];
    const rungs = [frames.l1, frames.l2, frames.l3].filter(
      (f): f is string => typeof f === 'string',
    );

    // 0 = idle, 1 = hovering, 2..n = clicked that many times past hover.
    let level = 0;
    let tick = 0;
    let hovering = false;
    let recovering = false;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const paint = () => {
      if (recovering) return;
      if (level > 0 && rungs[level - 1]) face.textContent = rungs[level - 1];
      else face.textContent = idle[tick % idle.length];
    };

    // Idle cycling is the only part that is not user-initiated, so it is
    // the only part reduced motion switches off.
    // Each card gets its own period and start offset. With a shared
    // interval every face flipped on the same frame, which read as one
    // animation rather than four independent things idling.
    if (!reduce && idle.length > 1) {
      const period = 900 + Math.round(Math.random() * 700);
      setTimeout(
        () => {
          setInterval(() => {
            tick += 1;
            if (level === 0) paint();
          }, period);
        },
        Math.round(Math.random() * period),
      );
    }

    const settle = () => {
      if (timer) clearTimeout(timer);
      recovering = true;
      if (frames.recover) face.textContent = frames.recover;
      timer = setTimeout(() => {
        recovering = false;
        level = hovering ? 1 : 0;
        paint();
      }, 1100);
    };

    card.addEventListener('mouseenter', () => {
      hovering = true;
      if (level === 0 && !recovering) {
        level = 1;
        paint();
      }
    });

    card.addEventListener('mouseleave', () => {
      hovering = false;
      if (!recovering) {
        level = 0;
        paint();
      }
    });

    // No preventDefault — these still have to navigate once the hrefs
    // are real.
    card.addEventListener('click', () => {
      if (recovering) return;
      if (level < rungs.length) {
        level += 1;
        paint();
        if (level >= rungs.length) {
          if (timer) clearTimeout(timer);
          timer = setTimeout(settle, 900);
        }
      }
    });
  }
</script>
