---
/**
 * The cover plate at the top of a guide.
 *
 * The same drawing as the guide's card in the rail, at nearly twice the
 * sampling and alive rather than flat. It renders from a tone grid on a
 * canvas for the same reason the hero does: a cell cannot climb the ramp
 * — under a cursor or under a passing shimmer — if the only thing
 * shipped is the character it already landed on.
 *
 * The idle animation is a soft diagonal band of heat travelling across
 * the plate, which is the same heat the pointer applies. One mechanism,
 * so the cover is already doing quietly what your cursor does loudly,
 * and reaching for it feels like joining in rather than switching modes.
 */

interface Chapter {
  href: string;
  part: number;
  label: string;
}

interface Props {
  /** Basename of the grid in `static/art`, without `-grid.json`. */
  art: string;
  title: string;
  subtitle?: string;
  /** What a reader can do afterwards. Not a contents list. */
  benefits?: string[];
  /** Rendered above the title — "6 parts", a date, whatever the page has. */
  eyebrow?: string;
  /** Where "start reading" goes, if there is a first chapter. */
  startHref?: string;
  chapters?: Chapter[];
}

const {
  art,
  title,
  subtitle,
  benefits = [],
  eyebrow,
  startHref,
  chapters = [],
} = Astro.props;
---

<!-- Sized in viewport units rather than by aspect ratio. A cover is
     "the first screen", and a fixed ratio makes that a different amount
     of screen on every device — a 21:9 plate is a band on a phone and a
     wall on a monitor. `min-h` rather than `h`, so a long benefit list
     pushes the cover taller instead of overflowing it.

     The artwork gets its own portrait panel rather than sitting behind
     the type. Cropped to a wide band it was a strip of a drawing nobody
     could identify; at its own 3:4 it is the drawing, which is the whole
     reason it was commissioned. -->
<header
  class="relative isolate mx-auto flex min-h-[max(32rem,84svh)] w-full max-w-6xl flex-col justify-center gap-10 px-(--spacing-gutter) pt-24 pb-14 lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-center lg:gap-16"
>
  <div class="order-2 lg:order-1">
    {eyebrow && <p class="nameplate mb-3 text-primary">{eyebrow}</p>}

    <h1 class="max-w-[16ch] text-3xl sm:text-4xl lg:text-5xl">{title}</h1>

    {
      subtitle && (
        <p class="mt-4 max-w-[52ch] text-base text-muted-foreground sm:text-lg">{subtitle}</p>
      )
    }

    {
      benefits.length > 0 && (
        <ul class="mt-7 grid max-w-[60ch] gap-2.5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {benefits.map((benefit) => (
            <li class="flex gap-2.5 text-sm leading-snug">
              {/* The one contrast accent, rationed: a lit pip per line,
                  the same vocabulary as the indicator lamps. */}
              <span
                aria-hidden="true"
                class="mt-1.5 size-1.5 shrink-0 rounded-full bg-[var(--contrast)]"
              />
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-8 flex flex-wrap items-center gap-4">
      {
        startHref && (
          <a
            href={startHref}
            class="cap inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-sm font-medium transition-colors hover:text-primary"
          >
            Start reading <span aria-hidden="true">→</span>
          </a>
        )
      }
      {
        chapters.length > 0 && (
          <p class="font-mono text-xs text-muted-foreground">
            {chapters.length + 1} parts · read in order
          </p>
        )
      }
    </div>

    {
      chapters.length > 0 && (
        <ol class="mt-7 grid gap-px border-t border-rule pt-4 font-mono text-xs">
          {chapters.map((chapter) => (
            <li>
              <a
                href={chapter.href}
                class="flex gap-3 rounded-xs px-2 py-1.5 text-muted-foreground transition-colors hover:bg-primary/5 hover:text-foreground"
              >
                <span class="text-primary">{String(chapter.part).padStart(2, '0')}</span>
                <span class="min-w-0">{chapter.label}</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>

  <!-- The plate, mounted. A chassis with screws and a recessed screen
       rather than a bare canvas, so it reads as an instrument on the
       bench like everything else here — and so the artwork has an edge
       to be framed by instead of dissolving into the page. -->
  <div class="order-1 lg:order-2">
    <div class="chassis group relative mx-auto w-full max-w-[22rem] p-3 lg:max-w-none">
      <span aria-hidden="true" class="screw absolute top-2 left-2"></span>
      <span aria-hidden="true" class="screw absolute top-2 right-2"></span>
      <span aria-hidden="true" class="screw absolute bottom-2 left-2"></span>
      <span aria-hidden="true" class="screw absolute bottom-2 right-2"></span>

      <div class="crt relative aspect-[3/4] w-full overflow-hidden">
        <canvas
          data-guide-cover
          data-art={art}
          aria-hidden="true"
          class="absolute inset-0 size-full opacity-0 transition-opacity duration-700"></canvas>
      </div>
    </div>
  </div>
</header>

<script>
  import { TREATMENT_RAMPS, readTreatment } from '@/lib/treatments';

  /** Cutoff and its per-cell wobble, as in the hero: a single flat
      threshold draws a clean contour, which inked art never has. */
  const CUT = 0.11;
  const JITTER = 0.06;
  const HOT_INK: readonly [number, number, number] = [244, 122, 183];
  /** Seconds for the shimmer to cross the plate once. */
  const SWEEP = 9;
  /** Half-width of the shimmer band, in fractions of the diagonal. */
  const BAND = 0.13;
  /** Radius of the pointer's stamp, in cells, and how fast it cools. */
  const REACH = 10;
  const DECAY = 0.94;

  function inkFor(dark: boolean): [number, number, number] {
    return dark ? [226, 236, 255] : [46, 52, 68];
  }

  function hash01(x: number, y: number): number {
    return ((((x * 374761393) ^ (y * 668265263)) >>> 0) % 1024) / 1024;
  }

  interface Grid {
    cols: number;
    rows: number;
    lum: string;
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-guide-cover]')) {
    const ctx = canvas.getContext('2d');
    const art = canvas.dataset.art;
    if (!ctx || !art) continue;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let cols = 0;
    let rows = 0;
    let lum = new Uint8Array(0);
    let cw = 0;
    let chh = 0;
    /** Top-left of the drawn grid inside the canvas box; negative when
        the plate is cropping. */
    let ox = 0;
    let oy = 0;
    let ink = inkFor(document.documentElement.classList.contains('dark'));
    let ramp = TREATMENT_RAMPS[readTreatment(document.documentElement)];
    let raf = 0;
    let phase = 0;
    /** Pointer heat, in addition to the shimmer. One buffer, because a
        finger and a passing band are the same thing to a cell. */
    let touch = new Float32Array(0);
    let touched = false;

    function measure(): boolean {
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0 || cols === 0) return false;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      /* Cover, not stretch. The grid is 3:4 and the plate is nearly 2:1;
         deriving cell size from each axis independently squashed the
         drawing flat, which at a glance read as "the art is faint" rather
         than "the art is the wrong shape". One scale for both axes, the
         larger of the two fits, and the overflow crops evenly. */
      const unit = Math.max(rect.width / cols, rect.height / (rows * 2));
      cw = unit;
      chh = unit * 2;
      ox = (rect.width - cols * cw) / 2;
      oy = (rect.height - rows * chh) / 2;

      ctx.font = `${(chh * 0.98).toFixed(2)}px ui-monospace, SFMono-Regular, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      return true;
    }

    function draw(): void {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Skip the rows and columns the crop has pushed outside the plate.
      const rect = canvas.getBoundingClientRect();
      const y0 = Math.max(0, Math.floor(-oy / chh));
      const y1 = Math.min(rows - 1, Math.ceil((rect.height - oy) / chh));
      const x0 = Math.max(0, Math.floor(-ox / cw));
      const x1 = Math.min(cols - 1, Math.ceil((rect.width - ox) / cw));

      for (let y = y0; y <= y1; y += 1) {
        for (let x = x0; x <= x1; x += 1) {
          const base = (lum[y * cols + x] ?? 0) / 255;

          /* Distance from the travelling band, measured along a diagonal
             so the sweep crosses the plate rather than wiping down it. */
          const along = (x / cols) * 0.72 + (y / rows) * 0.28;
          const d = Math.abs(along - phase);
          const sweep = d > BAND ? 0 : (1 - d / BAND) ** 2 * 0.55;
          const heat = Math.min(1, sweep + (touch[y * cols + x] ?? 0));

          if (base + heat * 0.5 < CUT + (hash01(x, y) - 0.5) * 2 * JITTER) continue;

          const lit = Math.min(1, base + heat * 0.35);
          const glyph = ramp[Math.min(ramp.length - 1, Math.floor(lit * ramp.length))];
          if (!glyph || glyph === ' ') continue;

          const t = Math.min(1, heat * 1.6);
          const r = Math.round(ink[0] + (HOT_INK[0] - ink[0]) * t);
          const g = Math.round(ink[1] + (HOT_INK[1] - ink[1]) * t);
          const b = Math.round(ink[2] + (HOT_INK[2] - ink[2]) * t);

          ctx.fillStyle = `rgba(${r},${g},${b},${Math.min(1, 0.35 + lit * 0.7)})`;
          ctx.fillText(glyph, ox + x * cw + cw / 2, oy + y * chh + chh / 2);
        }
      }
    }

    let last = 0;
    function tick(now: number): void {
      // Rate-limited to ~24fps. This repaints the whole plate — there is
      // no small dirty region when the thing moving is a band crossing
      // all of it — and a shimmer does not need 60.
      if (now - last > 41) {
        last = now;
        phase = ((now / 1000 / SWEEP) % 1.4) - 0.2;

        if (touched) {
          let alive = false;
          for (let i = 0; i < touch.length; i += 1) {
            const h = (touch[i] ?? 0) * DECAY;
            touch[i] = h > 0.004 ? h : 0;
            if (touch[i] > 0) alive = true;
          }
          touched = alive;
        }

        draw();
      }
      raf = requestAnimationFrame(tick);
    }

    fetch(`/art/${art}-grid.json`)
      .then((res) => res.json() as Promise<Grid>)
      .then((grid) => {
        cols = grid.cols;
        rows = grid.rows;
        lum = Uint8Array.from(atob(grid.lum), (c) => c.charCodeAt(0));
        touch = new Float32Array(cols * rows);

        if (!measure()) return;
        draw();
        canvas.classList.remove('opacity-0');

        new ResizeObserver(() => {
          if (measure()) draw();
        }).observe(canvas);

        new MutationObserver(() => {
          ink = inkFor(document.documentElement.classList.contains('dark'));
          ramp = TREATMENT_RAMPS[readTreatment(document.documentElement)];
          draw();
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-treatment'],
        });

        /* Hover and tap both reach it. `pointermove` covers a mouse; a
           touch drag fires the same event, so the two need no separate
           path — and `touch-action` is left alone so a scroll gesture
           over the plate still scrolls. */
        const stamp = (event: PointerEvent) => {
          const rect = canvas.getBoundingClientRect();
          const cx = Math.floor((event.clientX - rect.left - ox) / cw);
          const cy = Math.floor((event.clientY - rect.top - oy) / chh);

          for (let dy = -REACH; dy <= REACH; dy += 1) {
            for (let dx = -REACH; dx <= REACH; dx += 1) {
              const x = cx + dx;
              const y = cy + dy;
              if (x < 0 || y < 0 || x >= cols || y >= rows) continue;
              const dist = Math.hypot(dx, dy);
              if (dist > REACH) continue;
              const i = y * cols + x;
              touch[i] = Math.min(1, (touch[i] ?? 0) + (1 - dist / REACH) * 0.4);
            }
          }
          touched = true;
          // A still plate has no loop running to pick this up.
          if (reduce.matches) draw();
        };

        canvas.parentElement?.addEventListener('pointermove', stamp);

        if (reduce.matches) return;

        // Nothing off-screen has any business holding a rAF loop open.
        new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !raf) raf = requestAnimationFrame(tick);
            else if (!entry.isIntersecting && raf) {
              cancelAnimationFrame(raf);
              raf = 0;
            }
          }
        }).observe(canvas);
      })
      .catch(() => {
        /* No cover art; the title below still reads. */
      });
  }
</script>
