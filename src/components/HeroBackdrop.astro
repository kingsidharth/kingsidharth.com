---
/**
 * The thangka behind the hero.
 *
 * A colossal seated Buddha holding one plain slab on an open palm, and
 * standing on the ground line beneath it, a single present-day human
 * about a tenth of the frame high. The whole composition exists for that
 * ratio; the figure is cropped by the top edge because being cut off by
 * the frame is what tells you how big something is.
 *
 * Symbolic rather than painted, then run through the same block-glyph
 * pipeline as every other image on this site. An ornate raster on top of
 * an ascii site is a visitor; this is made of the same material.
 *
 * It ships twice: an SVG in `noscript`, and canvases everywhere else.
 * The canvas renders from tone rather than from baked characters, which
 * is the only way a cell can climb the ramp and change glyph under the
 * cursor — that is the interaction: the statue's own glyphs transform,
 * rather than something else moving over the top of it.
 */
interface Props {
  class?: string;
}

const { class: extra = '' } = Astro.props;

/* Legibility comes from masking the artwork, not from laying a scrim
   over it. A scrim has to be a colour, and the one colour that works on
   near-black is wrong on cream; a mask removes ink and is correct in
   both themes.
 *
 * Two layers, intersected, and the split between them matters more than
 * it used to. The artwork now reads as stacked tonal plates separated by
 * pale mist, and those mist bands run straight through the middle of the
 * frame — exactly where a horizontal scrim would sit. Dimming the whole
 * band erased the thing that makes the layers legible. So the band does
 * almost nothing now, and nearly all the work is done by an ellipse over
 * the copy block itself, where the loss actually buys something.
 *
 * Real spaces, not underscores: the underscore-for-space escape is a
 * Tailwind arbitrary-value convention and means nothing in a plain
 * `style` attribute, where one invalid stop discards the declaration. */
const maskLayers = [
  'linear-gradient(to bottom,#000 0%,#000 30%,rgb(0 0 0 / 0.82) 44%,rgb(0 0 0 / 0.82) 70%,#000 84%,#000 97%,transparent 100%)',
  'radial-gradient(50% 40% at 27% 58%,rgb(0 0 0 / 0.06) 0%,rgb(0 0 0 / 0.38) 52%,#000 100%)',
].join(',');

/* `intersect` so the two layers multiply. The default is `add`, which
   would union them — every masked region filled back in by the other,
   and no visible effect at all. */
const maskStyle = [
  `-webkit-mask-image:${maskLayers}`,
  `mask-image:${maskLayers}`,
  '-webkit-mask-composite:source-in',
  'mask-composite:intersect',
].join(';');

/* The sky gets the ellipse and NOT the band.
 *
 * The clouds drift through the middle third of the frame, which is
 * exactly where the band cuts hardest — with the statue's mask applied
 * they were being halved in the only place they exist, and the effect
 * read as "the clouds are not working" rather than "the clouds are
 * masked". They are soft and semi-transparent already; the ellipse over
 * the copy is the only part they actually need. */
const cloudMask = 'radial-gradient(50% 40% at 27% 58%,rgb(0 0 0 / 0.12) 0%,rgb(0 0 0 / 0.5) 52%,#000 100%)';
const cloudMaskStyle = [`-webkit-mask-image:${cloudMask}`, `mask-image:${cloudMask}`].join(';');
---

<div
  class:list={[
    'pointer-events-none absolute top-0 left-1/2 -translate-x-1/2',
    /* Wider than the phone on purpose. A 2:1 image fitted to a 390px
       viewport is a 195px strip, and a colossal statue rendered 195px
       tall is not colossal — the scale the whole picture is built on
       collapses. Overflowing the viewport keeps the figure big, which is
       the only way the human at its feet means anything. */
    'w-[168%] max-w-none sm:w-full sm:max-w-[88rem]',
    /* The edges are dissolved rather than cut: a hard vertical boundary
       between artwork and page reads as a mistake. */
    '[mask-image:linear-gradient(90deg,transparent_0%,#000_9%,#000_91%,transparent_100%)]',
    extra,
  ]}
  aria-hidden="true"
>
  <!-- In `noscript` on purpose.
       Rendered normally these paint first, then get hidden the moment
       the canvas is ready, then the canvas fades up — which reads as a
       flash, a blank, and a fade rather than as one arrival. They exist
       only for the no-JS case, so that is the only case that should see
       them. When JS is on the entry animation IS the reveal, and it
       should not be competing with a still frame of itself. -->
  <noscript>
    <img
      src="/art/hero-thangka.svg"
      alt=""
      width="1320"
      height="660"
      style={maskStyle}
      class="hidden w-full dark:block"
    />
    <img
      src="/art/hero-thangka-light.svg"
      alt=""
      width="1320"
      height="660"
      style={maskStyle}
      class="w-full dark:hidden"
    />
  </noscript>

  <!-- Two canvases, not one: the far plate (statue, ranges, mist) and
       the near plate (the foreground ledge and its path). Splitting them
       is what allows a parallax offset on scroll, and doing it as two
       elements means the offset is a compositor transform rather than a
       full 25,600-cell repaint every frame.

       Sized off the image beside them rather than given their own box,
       so the swap when they go live cannot shift anything. -->
  <!-- Paint order is DOM order here — none of these carry a z-index —
       so the back cloud bank sits behind the statue and the front one
       passes over it. That is the whole trick: without something in
       front, layered clouds are just a busier sky. -->
  <canvas
    data-hero-cloud="back"
    data-enter={"-14px"}
    data-enter-delay={"0ms"}
    style={cloudMaskStyle}
    class="absolute inset-0 size-full opacity-0 will-change-transform"></canvas>
  <canvas
    data-hero-canvas="far"
    data-enter={"22px"}
    data-enter-delay={"90ms"}
    style={maskStyle}
    class="absolute inset-0 size-full opacity-0 will-change-transform"></canvas>
  <canvas
    data-hero-canvas="near"
    data-enter={"38px"}
    data-enter-delay={"160ms"}
    style={maskStyle}
    class="absolute inset-0 size-full opacity-0 will-change-transform"></canvas>
  <canvas
    data-hero-cloud="front"
    data-enter={"54px"}
    data-enter-delay={"240ms"}
    style={cloudMaskStyle}
    class="absolute inset-0 size-full opacity-0 will-change-transform"></canvas>
</div>


<script>
  import {
    HOT_RAMP,
    TREATMENT_RAMPS,
    readFringeOffset,
    readTreatment,
  } from '@/lib/treatments';

  /** Radius of the pointer's stamp, in cells. */
  const REACH = 8;
  /** Per-frame heat decay: about two seconds of tail at 60fps. */
  const DECAY = 0.955;
  const HOT_INK: readonly [number, number, number] = [244, 122, 183];

  /** Row fraction where the foreground ledge begins in the source. */
  const NEAR_FROM = 0.72;

  /* Visibility cutoff, and how far a cell may wander either side of it.
     The export bakes almost no floor, so the edge between picture and
     nothing is decided here — jittered per cell, because a single
     threshold applied evenly draws a clean contour line, and a clean
     contour is the one thing a hand-inked image never has. */
  const CUT = 0.1;
  const JITTER = 0.06;

  /** How far the two plates separate over a screen of scrolling. */
  const FAR_DRIFT = 34;
  const NEAR_DRIFT = -16;

  /**
   * The sky, as sprites.
   *
   * Drawn artwork rather than a procedural field. The first version was
   * a threshold on a few sines and it read as wide horizontal smears,
   * because that is what a sine field is — clouds have lobes, and the
   * lobes are the thing you recognise.
   *
   * Each sprite's grid is generated at a column count that makes its
   * cells the same size as the statue's, so a cloud crossing the
   * mountains belongs to the same print rather than sitting on top of it.
   *
   * `depth` is the whole illusion: it sets speed, and speed is the only
   * cue that separates a small near cloud from a large far one.
   */
  interface Cloud {
    art: 'cloud-far' | 'cloud-mid' | 'cloud-near';
    /** Row the sprite's top sits on. */
    row: number;
    /** Cells per second. */
    speed: number;
    alpha: number;
    /** Starting offset along the loop, in cells. */
    offset: number;
  }

  const BACK_CLOUDS: Cloud[] = [
    { art: 'cloud-far', row: 3, speed: 0.9, alpha: 0.5, offset: 0 },
    { art: 'cloud-far', row: 20, speed: 1.3, alpha: 0.45, offset: 150 },
    { art: 'cloud-mid', row: 8, speed: 2.1, alpha: 0.62, offset: 250 },
  ];

  const FRONT_CLOUDS: Cloud[] = [
    { art: 'cloud-mid', row: 42, speed: 4.2, alpha: 0.72, offset: 60 },
    { art: 'cloud-near', row: 30, speed: 7.5, alpha: 0.85, offset: 300 },
  ];

  /** Birds, on the front layer so they pass over everything. */
  const FLOCK = 7;
  const BIRD_GLYPHS = ['v', '^'] as const;

  interface Grid {
    cols: number;
    rows: number;
    lum: string;
  }

  function inkFor(dark: boolean): [number, number, number] {
    return dark ? [242, 227, 196] : [58, 47, 34];
  }

  /** Deterministic 0-1 per cell. Stable across repaints, so the ragged
      edge and the disco glitter stay put instead of crawling. */
  function hash01(x: number, y: number): number {
    return ((((x * 374761393) ^ (y * 668265263)) >>> 0) % 1024) / 1024;
  }

  /**
   * The entry.
   *
   * Each plate arrives from a little below its resting place and fades
   * up, further and later the nearer it is — which is the same parallax
   * the scroll uses, played once on arrival. The depth is already true;
   * this just says so before you have touched anything.
   *
   * It rides the `translate` property, not `transform`, because the
   * scroll parallax owns `transform` and the two would overwrite each
   * other. `translate` is applied first and composes cleanly, so the
   * entry can finish while the scroll offset keeps working.
   */
  function enter(canvases: HTMLCanvasElement[]): void {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    for (const canvas of canvases) {
      const from = canvas.dataset.enter ?? '0px';
      const delay = canvas.dataset.enterDelay ?? '0ms';

      if (still) {
        canvas.classList.remove('opacity-0');
        continue;
      }

      canvas.style.translate = `0 ${from}`;
      canvas.style.transition = `translate 1100ms cubic-bezier(0.16, 1, 0.3, 1) ${delay}, opacity 800ms ease ${delay}`;

      // Two frames, not one. Setting the start and the end inside the
      // same frame gives the browser one computed style and no
      // transition — the plate would simply appear in place.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          canvas.classList.remove('opacity-0');
          canvas.style.translate = '0 0';
        });
      });
    }
  }

  const far = document.querySelector<HTMLCanvasElement>('canvas[data-hero-canvas="far"]');
  const near = document.querySelector<HTMLCanvasElement>('canvas[data-hero-canvas="near"]');
  const cloudBack = document.querySelector<HTMLCanvasElement>('canvas[data-hero-cloud="back"]');
  const cloudFront = document.querySelector<HTMLCanvasElement>('canvas[data-hero-cloud="front"]');
  const host = far?.parentElement?.parentElement;

  if (far && near && cloudBack && cloudFront && host) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    let cols = 0;
    let rows = 0;
    /** First row belonging to the near plate. */
    let split = 0;
    let lum = new Uint8Array(0);
    let heat = new Float32Array(0);
    let cw = 0;
    let chh = 0;
    let ink = inkFor(document.documentElement.classList.contains('dark'));
    let treatment = readTreatment(document.documentElement);
    let cool = TREATMENT_RAMPS[treatment];
    let fringe = readFringeOffset(document.documentElement);
    let raf = 0;

    const ctxOf = (canvas: HTMLCanvasElement) => canvas.getContext('2d');

    /** Bounding box of cells holding heat, so a frame redraws a patch
        and not the whole 320x80 grid. */
    let box = { x0: 0, y0: 0, x1: -1, y1: -1 };

    const widen = (x: number, y: number) => {
      if (box.x1 < box.x0) {
        box = { x0: x, y0: y, x1: x, y1: y };
        return;
      }
      box.x0 = Math.min(box.x0, x);
      box.y0 = Math.min(box.y0, y);
      box.x1 = Math.max(box.x1, x);
      box.y1 = Math.max(box.y1, y);
    };

    /**
     * Paint one plate over a cell rectangle.
     *
     * Both canvases cover the whole element and share one coordinate
     * system; each simply declines the rows that are not its own. That
     * keeps the split a rendering detail rather than a layout one, so
     * the two can be transformed independently without anything having
     * to line back up.
     */
    function paint(
      canvas: HTMLCanvasElement,
      from: number,
      to: number,
      x0: number,
      y0: number,
      x1: number,
      y1: number,
    ): void {
      const ctx = ctxOf(canvas);
      if (!ctx) return;

      const ry0 = Math.max(y0, from);
      const ry1 = Math.min(y1, to - 1);
      if (x1 < x0 || ry1 < ry0) return;

      ctx.clearRect(x0 * cw, ry0 * chh, (x1 - x0 + 1) * cw, (ry1 - ry0 + 1) * chh);

      for (let y = ry0; y <= ry1; y += 1) {
        for (let x = x0; x <= x1; x += 1) {
          const i = y * cols + x;
          const base = (lum[i] ?? 0) / 255;
          const h = heat[i] ?? 0;

          // The jittered cutoff. Heat lifts a cell over it, so the ragged
          // edge also softens wherever the pointer passes.
          if (base + h * 0.5 < CUT + (hash01(x, y) - 0.5) * 2 * JITTER) continue;

          const t = Math.min(1, h * 2);
          const lit = Math.min(1, base + h * 0.4);

          const set = h > 0.1 ? HOT_RAMP : cool;
          const glyph = set[Math.min(set.length - 1, Math.floor(lit * set.length))];
          if (!glyph || glyph === ' ') continue;

          // Crossfade toward the accent rather than switching at a
          // threshold — a hard switch leaves a visible ring where the
          // stamp ends, instead of a trail cooling on its way out.
          const r = Math.round(ink[0] + (HOT_INK[0] - ink[0]) * t);
          const g = Math.round(ink[1] + (HOT_INK[1] - ink[1]) * t);
          const b = Math.round(ink[2] + (HOT_INK[2] - ink[2]) * t);

          // Disco: a fixed hash lights roughly one cell in nine as a full
          // block pushed most of the way to white. Hashed, not random, or
          // a repaint reshuffles the glitter and the ball boils.
          let alpha = Math.min(1, 0.4 + lit * 0.7);
          let glyphOut = glyph;
          let rr = r;
          let gg = g;
          let bb = b;
          if (treatment === 'disco' && hash01(x + 7, y + 13) < 0.11) {
            glyphOut = '█';
            alpha = 1;
            rr = Math.round(r + (255 - r) * 0.75);
            gg = Math.round(g + (255 - g) * 0.75);
            bb = Math.round(b + (255 - b) * 0.75);
          }

          const px = x * cw + cw / 2;
          const py = y * chh + chh / 2;

          if (fringe === 0) {
            ctx.fillStyle = `rgba(${rr},${gg},${bb},${alpha})`;
            ctx.fillText(glyphOut, px, py);
            continue;
          }

          // Three single-channel copies summed with `lighter`, which is
          // what an additive display does: where they overlap they
          // reconstruct the ink and only the edges fringe. Compositing
          // normally would stack three coloured glyphs and the last would
          // win.
          const d = fringe * cw;
          ctx.globalCompositeOperation = 'lighter';
          ctx.fillStyle = `rgba(${rr},0,0,${alpha})`;
          ctx.fillText(glyphOut, px - d, py);
          ctx.fillStyle = `rgba(0,${gg},0,${alpha})`;
          ctx.fillText(glyphOut, px, py);
          ctx.fillStyle = `rgba(0,0,${bb},${alpha})`;
          ctx.fillText(glyphOut, px + d, py);
          ctx.globalCompositeOperation = 'source-over';
        }
      }
    }

    function paintBoth(x0: number, y0: number, x1: number, y1: number): void {
      paint(far, 0, split, x0, y0, x1, y1);
      paint(near, split, rows, x0, y0, x1, y1);
    }

    interface Sprite {
      cols: number;
      rows: number;
      lum: Uint8Array;
    }

    const sprites = new Map<string, Sprite>();

    /**
     * Blit one cloud into the grid at its drifting position.
     *
     * The loop is the sprite's width plus the grid's, so a cloud leaves
     * one side entirely before it re-enters the other and there is never
     * a moment where the same cloud is visible twice.
     */
    function drawCloud(ctx: CanvasRenderingContext2D, cloud: Cloud, t: number): void {
      const sprite = sprites.get(cloud.art);
      if (!sprite) return;

      const span = cols + sprite.cols;
      const originX = Math.round(((cloud.offset + t * cloud.speed) % span) - sprite.cols);

      for (let y = 0; y < sprite.rows; y += 1) {
        const gy = cloud.row + y;
        if (gy < 0 || gy >= rows) continue;

        for (let x = 0; x < sprite.cols; x += 1) {
          const gx = originX + x;
          if (gx < 0 || gx >= cols) continue;

          const base = (sprite.lum[y * sprite.cols + x] ?? 0) / 255;
          if (base < 0.1) continue;

          /* Biased up the ramp. Mapped linearly a cloud spends most of
             its range on the faint opening mark and disappears — right
             for the empty sky, wrong for the thing crossing it. */
          const lit = Math.min(1, 0.3 + base * 0.7);
          const glyph = cool[Math.min(cool.length - 1, Math.floor(lit * cool.length))];
          if (!glyph || glyph === ' ') continue;

          ctx.fillStyle = `rgba(${ink[0]},${ink[1]},${ink[2]},${(lit * cloud.alpha).toFixed(3)})`;
          ctx.fillText(glyph, gx * cw + cw / 2, gy * chh + chh / 2);
        }
      }
    }

    /**
     * Birds. One cell each — at this size a bird is not a shape you can
     * draw, it is a speck that moves like one, so the work is in the
     * path: a slow crossing, a lazy vertical wander, and a flap slow
     * enough to read as wingbeats instead of flicker.
     */
    function drawFlock(ctx: CanvasRenderingContext2D, t: number): void {
      for (let i = 0; i < FLOCK; i += 1) {
        const phase = i * 1.7;
        const speed = 2.6 + (i % 3) * 0.9;
        const span = cols + 24;
        const x = ((i * 37 + t * speed) % span) - 12;
        const y = rows * (0.16 + (i % 4) * 0.055) + Math.sin(t * 0.5 + phase) * 2.2;
        if (x < 0 || x >= cols) continue;

        const glyph = BIRD_GLYPHS[Math.floor(t * 3 + phase) % BIRD_GLYPHS.length];
        ctx.fillStyle = `rgba(${ink[0]},${ink[1]},${ink[2]},0.62)`;
        ctx.fillText(glyph, x * cw + cw / 2, y * chh + chh / 2);
      }
    }

    function drawClouds(t: number): void {
      if (cols === 0 || sprites.size === 0) return;

      const backCtx = ctxOf(cloudBack);
      if (backCtx) {
        backCtx.clearRect(0, 0, cols * cw, rows * chh);
        for (const cloud of BACK_CLOUDS) drawCloud(backCtx, cloud, t);
      }

      const frontCtx = ctxOf(cloudFront);
      if (frontCtx) {
        frontCtx.clearRect(0, 0, cols * cw, rows * chh);
        for (const cloud of FRONT_CLOUDS) drawCloud(frontCtx, cloud, t);
        drawFlock(frontCtx, t);
      }
    }

    function measure(): boolean {
      const rect = far.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0 || cols === 0) return false;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = rect.width / cols;
      chh = rect.height / rows;

      for (const canvas of [cloudBack, far, near, cloudFront]) {
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        const ctx = ctxOf(canvas);
        if (!ctx) continue;
        // setTransform, not scale: scale multiplies into whatever is
        // already there, so every resize would compound the last one.
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `${(chh * 0.98).toFixed(2)}px ui-monospace, SFMono-Regular, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
      }
      return true;
    }

    function repaintAll(): void {
      if (!measure()) return;
      for (const canvas of [far, near]) {
        ctxOf(canvas)?.clearRect(0, 0, cols * cw, rows * chh);
      }
      paintBoth(0, 0, cols - 1, rows - 1);
      drawClouds(performance.now() / 1000);
    }

    function tick(): void {
      const prev = { ...box };
      box = { x0: 0, y0: 0, x1: -1, y1: -1 };

      let alive = false;
      for (let y = prev.y0; y <= prev.y1; y += 1) {
        for (let x = prev.x0; x <= prev.x1; x += 1) {
          const i = y * cols + x;
          const h = (heat[i] ?? 0) * DECAY;
          heat[i] = h > 0.004 ? h : 0;
          if (heat[i] > 0) {
            widen(x, y);
            alive = true;
          }
        }
      }

      // Repaint the union of where heat was and where it still is, or
      // cooled cells keep the colour they had when the loop stopped.
      paintBoth(prev.x0, prev.y0, prev.x1, prev.y1);
      raf = alive ? requestAnimationFrame(tick) : 0;
    }

    function stamp(clientX: number, clientY: number): void {
      const rect = far.getBoundingClientRect();
      const cx = Math.floor((clientX - rect.left) / cw);
      const cy = Math.floor((clientY - rect.top) / chh);

      for (let dy = -REACH; dy <= REACH; dy += 1) {
        for (let dx = -REACH; dx <= REACH; dx += 1) {
          const x = cx + dx;
          const y = cy + dy;
          if (x < 0 || y < 0 || x >= cols || y >= rows) continue;
          const d = Math.hypot(dx, dy);
          if (d > REACH) continue;
          const i = y * cols + x;
          heat[i] = Math.min(1, (heat[i] ?? 0) + (1 - d / REACH) * 0.5);
          widen(x, y);
        }
      }

      if (reduce.matches) {
        // No tail: cells under the pointer transform and release the
        // moment it moves on.
        paintBoth(0, 0, cols - 1, rows - 1);
        heat.fill(0);
        return;
      }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    fetch('/art/hero-grid.json')
      .then((res) => res.json() as Promise<Grid>)
      .then((grid) => {
        cols = grid.cols;
        rows = grid.rows;
        split = Math.round(rows * NEAR_FROM);
        lum = Uint8Array.from(atob(grid.lum), (c) => c.charCodeAt(0));
        heat = new Float32Array(cols * rows);

        // The sky can arrive late without anything looking broken, so it
        // is not worth blocking the statue on.
        void Promise.all(
          [...new Set([...BACK_CLOUDS, ...FRONT_CLOUDS].map((c) => c.art))].map(async (art) => {
            const res = await fetch(`/art/${art}-grid.json`);
            const g = (await res.json()) as Grid;
            sprites.set(art, {
              cols: g.cols,
              rows: g.rows,
              lum: Uint8Array.from(atob(g.lum), (c) => c.charCodeAt(0)),
            });
          }),
        ).then(() => drawClouds(performance.now() / 1000));

        repaintAll();
        enter([cloudBack, far, near, cloudFront]);

        new ResizeObserver(repaintAll).observe(far);

        // Theme ink, treatment and fringing all arrive as attributes on
        // <html>, and a canvas can inherit none of them.
        new MutationObserver(() => {
          const root = document.documentElement;
          const nextInk = inkFor(root.classList.contains('dark'));
          const nextTreatment = readTreatment(root);
          const nextFringe = readFringeOffset(root);
          if (nextInk[0] === ink[0] && nextTreatment === treatment && nextFringe === fringe) {
            return;
          }
          ink = nextInk;
          treatment = nextTreatment;
          cool = TREATMENT_RAMPS[treatment];
          fringe = nextFringe;
          repaintAll();
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-treatment', 'data-fringe'],
        });

        if (matchMedia('(hover: hover)').matches) {
          host.addEventListener('pointermove', (event: PointerEvent) => {
            stamp(event.clientX, event.clientY);
          });
        }

        /* The sky loop. Separate from the heat loop above because they
           answer to different things: heat only runs while it is decaying,
           clouds run for as long as the hero is on screen. 20fps — these
           cross the frame over a minute, and nothing about that needs 60.

           Under reduced motion the banks are drawn once and left there:
           the layering is the picture, the drift is the part someone
           asked us not to do. */
        if (reduce.matches) {
          drawClouds(0);
        } else {
          let skyRaf = 0;
          let lastSky = 0;
          const sky = (now: number) => {
            if (now - lastSky > 48) {
              lastSky = now;
              drawClouds(now / 1000);
            }
            skyRaf = requestAnimationFrame(sky);
          };

          // Nothing off-screen has any business holding a rAF loop open.
          new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting && !skyRaf) skyRaf = requestAnimationFrame(sky);
              else if (!entry.isIntersecting && skyRaf) {
                cancelAnimationFrame(skyRaf);
                skyRaf = 0;
              }
            }
          }).observe(cloudFront);
        }

        /* Parallax. The two plates slide apart as the hero leaves, which
           is the only moment the separation is visible — a still hero has
           no parallax to show. Transform only, so this stays on the
           compositor and never triggers the 25,600-cell repaint above. */
        if (reduce.matches) return;
        let scrollRaf = 0;
        const onScroll = () => {
          if (scrollRaf) return;
          scrollRaf = requestAnimationFrame(() => {
            scrollRaf = 0;
            const progress = Math.min(1, Math.max(0, window.scrollY / window.innerHeight));
            // The banks take the drift too, further apart than the
            // plates they sit between, so the depth order survives the
            // scroll instead of collapsing halfway down it.
            cloudBack.style.transform = `translate3d(0,${(progress * FAR_DRIFT * 1.35).toFixed(1)}px,0)`;
            far.style.transform = `translate3d(0,${(progress * FAR_DRIFT).toFixed(1)}px,0)`;
            near.style.transform = `translate3d(0,${(progress * NEAR_DRIFT).toFixed(1)}px,0)`;
            cloudFront.style.transform = `translate3d(0,${(progress * NEAR_DRIFT * 1.6).toFixed(1)}px,0)`;
          });
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })
      .catch(() => {
        /* The SVG is still there; nothing to recover. */
      });
  }
</script>
