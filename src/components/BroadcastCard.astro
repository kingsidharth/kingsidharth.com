---
import type { CollectionEntry } from 'astro:content';
import DitherThumb from './DitherThumb';
import { formatCompact, formatDate, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

interface Props {
  entry: CollectionEntry<'broadcasts'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, series, episode, duration, pubDate, views, url, motif, seed } = entry.data;
const t = useTranslations(locale);
---

<a href={url} class="group block">
  <div class="relative aspect-video overflow-hidden rounded-md border border-chassis-edge">
    <DitherThumb motif={motif} seed={seed} width={320} aspect="video" client:visible />

    <!-- The dither is 1-bit and inverts with the theme, so a light-mode
         thumbnail can be almost entirely ink-on-white right where the
         title sits. The scrim has to be opaque enough to carry white
         text over the worst case, not just the average one. -->
    <div
      class="absolute inset-0 bg-linear-to-t from-black/90 via-black/40 via-40% to-black/20"
      aria-hidden="true"
    >
    </div>

    <span
      class="absolute top-2 left-2 z-10 bg-primary px-1.5 py-0.5 font-mono text-2xs text-primary-foreground"
    >
      {series} · {episode}
    </span>
    <span class="absolute top-2 right-2 z-10 bg-black/80 px-1.5 py-0.5 font-mono text-2xs text-white">
      {duration}
    </span>

    <h3
      class="absolute inset-x-0 bottom-0 z-10 p-3 text-xl font-bold text-white transition-colors group-hover:text-primary"
    >
      {title}
    </h3>
  </div>

  <p class="mt-2.5 flex justify-between gap-3 font-mono text-xs text-muted-foreground">
    <span>{formatDate(pubDate, locale, { year: undefined })}</span>
    {views && <span>{formatCompact(views, locale)} {t('broadcasts.views')}</span>}
  </p>
</a>
