---
/**
 * The teaching numbers, lifted out of the hero into their own band.
 * Static — the star row is five paths with a clip on the fractional
 * one, so a 4.5 reads as four and a half rather than rounding to five.
 */
const rating = 4.5;
const stars = [1, 2, 3, 4, 5];

const STAR_PATH =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45l-5.81 3.05 1.11-6.47-4.7-4.58 6.5-.95z';
---

<div class="flex flex-wrap items-end gap-x-16 gap-y-8">
  <div>
    <p class="gauge-value">1M+</p>
    <p class="gauge-label">learners taught</p>
  </div>

  <div>
    <p class="flex items-center gap-3">
      <span class="gauge-value">{rating}+/5</span>

      <span class="flex gap-0.5" role="img" aria-label={`${rating} out of 5`}>
        {
          stars.map((i) => {
            const fill = Math.min(1, Math.max(0, rating - (i - 1)));
            return (
              <svg viewBox="0 0 24 24" class="size-4 shrink-0" aria-hidden="true">
                <path d={STAR_PATH} class="fill-muted-foreground/30" />
                {fill > 0 && (
                  <path
                    d={STAR_PATH}
                    class="fill-primary"
                    clip-path={`inset(0 ${(1 - fill) * 100}% 0 0)`}
                  />
                )}
              </svg>
            );
          })
        }
      </span>
    </p>
    <p class="gauge-label">average rating</p>
  </div>
</div>
