---
import type { CollectionEntry } from 'astro:content';
import { readingTime, splitId } from '@/lib/content';
import { formatDate, localePath, useTranslations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const { slug } = splitId(entry.id);

// TILs are short by definition — a reading time on them is noise.
const flag = entry.data.draft
  ? { text: t('notes.draft'), dim: true }
  : entry.data.kind === 'til'
    ? { text: 'Til', dim: false }
    : { text: `${readingTime(entry.body)} ${t('notes.readingTime')}`, dim: false };
---

<!-- Hover must not change the box. The old version animated padding,
     which nudged every row sideways and reflowed the list under the
     cursor. A left rule that fades in occupies space whether or not it
     is visible, so nothing moves. -->
<a
  href={localePath(splitId(entry.id).locale, `notes/${slug}`)}
  class="group relative flex items-baseline gap-4 border-b border-rule py-3.5 ps-4 transition-colors hover:bg-primary/5"
>
  <span
    class="absolute inset-y-1 start-0 w-px bg-primary opacity-0 transition-opacity group-hover:opacity-100"
    aria-hidden="true"></span>

  <time
    datetime={entry.data.pubDate.toISOString()}
    class="w-16 shrink-0 font-mono text-xs text-muted-foreground"
  >
    {formatDate(entry.data.pubDate, locale, { year: undefined })}
  </time>

  <span class="min-w-0 flex-1 font-bold transition-colors group-hover:text-primary">
    {entry.data.title}
  </span>

  <span
    class:list={[
      'shrink-0 font-mono text-2xs',
      flag.dim ? 'text-muted-foreground' : 'text-primary',
    ]}
  >
    {flag.text}
  </span>
</a>
