---
import { localePath } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/* Glyphs are drawn inline rather than pulled from an icon package:
   five paths do not justify a dependency, and these need to inherit
   currentColor to follow the accent palette. */
const icons = {
  youtube:
    'M21.6 7.2a2.5 2.5 0 0 0-1.75-1.77C18.25 5 12 5 12 5s-6.25 0-7.85.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.75 1.77C5.75 19 12 19 12 19s6.25 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15.2V8.8L15.5 12Z',
  github:
    'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.93.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94a3.9 3.9 0 0 1 1.03-2.7 3.6 3.6 0 0 1 .1-2.67s.84-.27 2.75 1.03a9.5 9.5 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.36.92.4 1.9.1 2.67a3.9 3.9 0 0 1 1.03 2.7c0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.86v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z',
  x: 'M18.9 2.5h3.4l-7.4 8.5 8.7 11.5h-6.8l-5.3-7-6.1 7H1.9l7.9-9.1L1.5 2.5h7l4.8 6.4ZM17.7 20.4h1.9L7.4 4.4H5.4Z',
  huggingface:
    'M12 2a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-3.4 6.6a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Zm6.8 0a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 16.5a4.6 4.6 0 0 1-4.2-2.7.7.7 0 0 1 1.3-.6 3.2 3.2 0 0 0 5.8 0 .7.7 0 0 1 1.3.6 4.6 4.6 0 0 1-4.2 2.7Z',
  flask:
    'M9 2v6.2L3.6 18a2.4 2.4 0 0 0 2.1 3.6h12.6a2.4 2.4 0 0 0 2.1-3.6L15 8.2V2M8 2h8M7.6 14h8.8',
};

const elsewhere = [
  { href: 'https://youtube.com/@kingsidharth', label: 'YouTube', icon: icons.youtube, fill: true },
  { href: 'https://github.com/kingsidharth', label: 'GitHub', icon: icons.github, fill: true },
  { href: 'https://x.com/kingsidharth', label: 'X', icon: icons.x, fill: true },
  {
    href: 'https://huggingface.co/kingsidharth',
    label: 'Hugging Face',
    icon: icons.huggingface,
    fill: true,
  },
  { href: 'https://xperiments.app', label: 'xperiments.app', icon: icons.flask, fill: false },
];
---

<footer class="mt-24 border-t border-rule">
  <div
    class="mx-auto flex max-w-(--container-wide) flex-wrap items-center justify-between gap-6 px-(--spacing-gutter) py-8 font-mono text-xs text-muted-foreground"
  >
    <p>Bengaluru</p>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <li>
        <a
          href={localePath(locale, 'blog')}
          class="transition-colors hover:text-foreground"
        >
          Notes
        </a>
      </li>
      {
        elsewhere.map((l) => (
          <li>
            <a
              href={l.href}
              rel="me noopener"
              class="group flex items-center gap-2 transition-colors hover:text-foreground"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-4 shrink-0 transition-colors group-hover:text-primary"
                fill={l.fill ? 'currentColor' : 'none'}
                stroke={l.fill ? 'none' : 'currentColor'}
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={l.icon} />
              </svg>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
