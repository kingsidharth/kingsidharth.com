---
interface Props {
  title: string;
  sub?: string;
  as?: 'h1' | 'h2';
  id?: string;
}

const { title, sub, as: Tag = 'h2', id } = Astro.props;
---

<div class="mb-8" id={id}>
  <Tag class="text-2xl">{title}</Tag>
  {sub && <p class="mt-1.5 font-mono text-xs text-muted-foreground">{sub}</p>}
</div>
