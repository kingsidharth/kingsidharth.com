---
/**
 * An asymmetric bento rather than a uniform grid: Temperature is the
 * flagship (the only instrument the quiz reveals), so it gets the wide
 * top-left cell — spanning two columns makes it wider, and since
 * InstrumentCard's screen is a fixed aspect ratio, wider also means
 * taller, with zero changes needed to InstrumentCard itself.
 */
import type { CollectionEntry } from 'astro:content';
import InstrumentCard from '@/components/InstrumentCard.astro';
import type { Locale } from '@/lib/i18n';

interface Props {
  entries: CollectionEntry<'instruments'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;

const byId = (id: string) => entries.find((e) => e.data.id === id);

const temperature = byId('temperature-visualiser');
const freshcast = byId('freshcast');
const agentsMd = byId('agents-md-generator');
const vibeCoding = byId('vibe-coding-guide');
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    temperature && (
      <div class="sm:col-span-2 lg:col-span-2">
        <InstrumentCard entry={temperature} locale={locale} />
      </div>
    )
  }

  {
    freshcast && (
      <div>
        <InstrumentCard entry={freshcast} locale={locale} />
      </div>
    )
  }

  {
    agentsMd && (
      <div>
        <InstrumentCard entry={agentsMd} locale={locale} />
      </div>
    )
  }

  {
    vibeCoding && (
      <div>
        <InstrumentCard entry={vibeCoding} locale={locale} />
      </div>
    )
  }

</div>
