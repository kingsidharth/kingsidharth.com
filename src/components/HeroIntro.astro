---
/**
 * Balanced on purpose. A pure list of what Sidharth does read like a
 * resume; pure benefit copy read like a landing page with nobody behind
 * it. The headline carries the person, the list carries what you get.
 */
const benefits = [
  'Steal prompts that work',
  'Get help with AI',
  'Build products',
  'Decode AI research',
  'Play, test & learn with tools',
];

/* The cycling word is rendered as a stack, not swapped in place: every
   word sits in the same grid cell, so the span is always as wide as the
   longest of them and nothing after it moves. Replacing the text
   content instead made "some" jump between lines on every tick. */
const words = ['AI', 'design', 'ML', 'tech', 'startup'];
---

<div class="flex w-full min-w-0 flex-col">
  <h1 class="max-w-[24ch] text-4xl sm:text-5xl">
    <span class="sr-only">Can I show you some cool AI stuff?</span>

    <span aria-hidden="true">
      Can I show you some cool{' '}
      <span
        data-cycle-track
        class="inline-grid justify-items-start overflow-hidden align-bottom transition-[width] duration-200"
      >
        {
          words.map((word, i) => (
            <span
              data-cycle-word
              data-active={i === 0 ? '' : undefined}
              class="col-start-1 row-start-1 text-primary opacity-0 transition-opacity duration-200 data-[active]:opacity-100"
            >
              {word}
            </span>
          ))
        }
      </span>{' '}
      stuff?
    </span>
  </h1>

  <p class="mt-5 max-w-[54ch] text-lg text-muted-foreground">
    I teach this for a living, to engineers and to people who have never written a line of code.
  </p>

  <ul class="mt-7 space-y-3 text-lg sm:text-xl">
    {
      benefits.map((item) => (
        <li class="flex gap-3.5">
          <span class="mt-[0.62em] h-px w-4 shrink-0 bg-primary" aria-hidden="true" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 max-w-[54ch] text-sm text-muted-foreground">
    16+ years with startups — Instamojo, Headout, now Outskill. College dropout. I also run a{' '}
    <a
      href="https://youtube.com/@kingsidharth"
      rel="noopener"
      class="text-primary hover:underline">YouTube channel</a
    >.
  </p>
</div>

<script>
  // The words are stacked in one grid cell so they can crossfade. That
  // makes the track as wide as the LONGEST word, which left a gap after
  // a short one — so the track's width is driven from the active word
  // and transitioned, giving a tight fit with no reflow of what follows.
  const track = document.querySelector<HTMLElement>('[data-cycle-track]');
  const words = document.querySelectorAll<HTMLElement>('[data-cycle-word]');

  if (track && words.length > 1) {
    const fit = (el: HTMLElement) => {
      track.style.width = `${el.getBoundingClientRect().width}px`;
    };

    // Fonts change metrics, so wait for them before the first measure.
    const start = () => {
      fit(words[0]);

      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let i = 0;
      setInterval(() => {
        words[i].removeAttribute('data-active');
        i = (i + 1) % words.length;
        words[i].setAttribute('data-active', '');
        fit(words[i]);
      }, 2200);
    };

    if (document.fonts?.ready) void document.fonts.ready.then(start);
    else start();

    addEventListener('resize', () => {
      const active = document.querySelector<HTMLElement>('[data-cycle-word][data-active]');
      if (active) fit(active);
    });
  }
</script>
