---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'series'>;
}

const { entry } = Astro.props;
const { title, url, seed, from, via, to, art, parts } = entry.data;

/* Each title is set differently — same ingredients, different recipe —
   so the row does not read as one template filled in twice. Letter
   spacing is deliberately absent: every line here is under 24px. */
const layouts: Record<string, { text: string; cls: string }[]> = {
  'pm-course-hinglish': [
    { text: 'PM Course', cls: 'block text-[22px] font-bold leading-none' },
    { text: 'in Hinglish', cls: 'mt-1 block text-[15px] font-light italic leading-none opacity-90' },
  ],
  'for-designers': [
    { text: 'For', cls: 'block text-[13px] font-light leading-none opacity-75' },
    { text: 'UI/UX', cls: 'mt-0.5 block text-[26px] font-extrabold leading-none' },
    { text: 'Designers', cls: 'mt-0.5 block text-[15px] font-medium leading-none opacity-90' },
  ],
};
const lines = layouts[entry.data.id] ?? [{ text: title, cls: 'block text-lg font-bold leading-tight' }];

/* Portrait, because that is the shape a series cover actually is.
 *
 * The ground is a layered gradient rather than the 1-bit dither used
 * elsewhere — you cannot desaturate art that has no colour in it. Angle
 * and blob positions come off the seed, so each cover is its own
 * composition but is identical between builds.
 *
 * The figure on top is the same block-glyph ascii art the banners use,
 * shipped as one <img> rather than inline: a thousand-odd <text> nodes
 * per card is what made this row scroll badly the first time.
 */
const angle = 120 + (seed % 7) * 15;
const bx = 20 + (seed % 5) * 12;
const by = 25 + (seed % 3) * 18;
---

<!-- The aspect ratio lives on the anchor, not the article: as a grid
     item the anchor is stretched to the row height, and an article
     sizing itself independently ended up a few pixels taller than the
     programme cards beside it. -->
<a href={url} class="group block aspect-[3/4] focus-visible:outline-none">
  <article
    class="relative flex size-full flex-col overflow-hidden rounded-lg border border-chassis-edge saturate-[0.55] transition-[filter] duration-300 group-hover:saturate-100 group-focus-visible:ring-2 group-focus-visible:ring-ring group-focus-visible:saturate-100"
  >
    <div
      class="absolute inset-0"
      style={`background:
        radial-gradient(60% 45% at ${bx}% ${by}%, ${via} 0%, transparent 70%),
        radial-gradient(70% 55% at ${100 - bx}% ${100 - by}%, ${to} 0%, transparent 72%),
        linear-gradient(${angle}deg, ${from} 0%, ${via} 55%, ${to} 100%)`}
      aria-hidden="true"
    >
    </div>

    <img
      src={`/art/${art}.svg`}
      alt=""
      loading="lazy"
      decoding="async"
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <div
      class="absolute inset-0 bg-[repeating-linear-gradient(0deg,rgb(0_0_0/0.13)_0_1px,transparent_1px_3px)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 bg-linear-to-t from-black/90 via-black/45 via-52% to-black/10"
      aria-hidden="true"
    >
    </div>



    <div class="relative z-10 mt-auto p-3.5">
      <h3 class="phosphor-type text-[oklch(0.97_0.03_190)]">
        {lines.map((l) => <span class={l.cls}>{l.text}</span>)}
      </h3>

      <p class="mt-1.5 font-mono text-xs text-white/60">{parts} videos</p>
    </div>
  </article>
</a>
