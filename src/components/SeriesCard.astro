---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'series'>;
}

const { entry } = Astro.props;
const { title, detail, url, seed, from, via, to } = entry.data;

/* Portrait, because that is the shape a video series cover actually is.
 *
 * The poster is a layered gradient rather than the dithered art used
 * elsewhere: that art is 1-bit, and you cannot desaturate something
 * with no colour in it. The angle and blob positions come off the seed
 * so each cover is its own composition but stays stable between builds.
 */
const angle = 120 + (seed % 7) * 15;
const bx = 20 + (seed % 5) * 12;
const by = 25 + (seed % 3) * 18;
---

<a href={url} class="group block">
  <div
    class="relative aspect-[3/4] overflow-hidden rounded-lg border border-chassis-edge saturate-[0.35] transition-[filter,transform] duration-300 group-hover:saturate-100 group-focus-visible:saturate-100"
  >
    <div
      class="absolute inset-0"
      style={`background:
        radial-gradient(60% 45% at ${bx}% ${by}%, ${via} 0%, transparent 70%),
        radial-gradient(70% 55% at ${100 - bx}% ${100 - by}%, ${to} 0%, transparent 72%),
        linear-gradient(${angle}deg, ${from} 0%, ${via} 55%, ${to} 100%)`}
      aria-hidden="true"
    >
    </div>

    <!-- Scanlines tie the poster back to the rest of the bench without
         making it a screen. -->
    <div
      class="absolute inset-0 bg-[repeating-linear-gradient(0deg,rgb(0_0_0/0.14)_0_1px,transparent_1px_3px)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 bg-linear-to-t from-black/85 via-black/25 via-45% to-transparent"
      aria-hidden="true"
    >
    </div>

    <span
      class="absolute top-2.5 left-2.5 z-10 rounded-xs bg-black/60 px-1.5 py-0.5 font-mono text-2xs text-white/90"
    >
      Series
    </span>

    <div class="absolute inset-x-0 bottom-0 z-10 p-3.5">
      <h3 class="text-lg leading-tight font-bold text-white">{title}</h3>
      <p class="mt-1 font-mono text-xs text-white/70">{detail}</p>
    </div>
  </div>
</a>
