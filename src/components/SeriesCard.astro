---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'series'>;
}

const { entry } = Astro.props;
const { title, url, seed, from, via, to, motif, parts } = entry.data;

/* Each title is set differently — same ingredients, different recipe —
   so the row does not read as one template filled in twice. Letter
   spacing is deliberately absent: every line here is under 24px. */
const layouts: Record<string, { text: string; cls: string }[]> = {
  'pm-course-hinglish': [
    { text: 'PM Course', cls: 'block text-[22px] font-bold leading-none' },
    { text: 'in Hinglish', cls: 'mt-1 block text-[15px] font-light italic leading-none opacity-90' },
  ],
  'for-designers': [
    { text: 'For', cls: 'block text-[13px] font-light leading-none opacity-75' },
    { text: 'UI/UX', cls: 'mt-0.5 block text-[26px] font-extrabold leading-none' },
    { text: 'Designers', cls: 'mt-0.5 block text-[15px] font-medium leading-none opacity-90' },
  ],
};
const lines = layouts[entry.data.id] ?? [{ text: title, cls: 'block text-lg font-bold leading-tight' }];

/* Portrait, because that is the shape a series cover actually is.
 *
 * The ground is a layered gradient rather than the 1-bit dither used
 * elsewhere — you cannot desaturate art that has no colour in it. Angle
 * and blob positions come off the seed, so each cover is its own
 * composition but is identical between builds.
 *
 * The drawing on top is line art rather than a photo: it survives being
 * desaturated, scales to any size, and matches the schematic language
 * the instruments already speak.
 */
const angle = 120 + (seed % 7) * 15;
const bx = 20 + (seed % 5) * 12;
const by = 25 + (seed % 3) * 18;
---

<a href={url} class="group block focus-visible:outline-none">
  <article
    class="relative flex aspect-[3/4] flex-col overflow-hidden rounded-lg border border-chassis-edge saturate-[0.35] transition-[filter] duration-300 group-hover:saturate-100 group-focus-visible:ring-2 group-focus-visible:ring-ring group-focus-visible:saturate-100"
  >
    <div
      class="absolute inset-0"
      style={`background:
        radial-gradient(60% 45% at ${bx}% ${by}%, ${via} 0%, transparent 70%),
        radial-gradient(70% 55% at ${100 - bx}% ${100 - by}%, ${to} 0%, transparent 72%),
        linear-gradient(${angle}deg, ${from} 0%, ${via} 55%, ${to} 100%)`}
      aria-hidden="true"
    >
    </div>

    <!-- Line art. Strokes are white at low alpha so one drawing works on
         any of the gradients without per-card colour tuning. -->
    <svg
      viewBox="0 0 120 96"
      class="absolute inset-x-0 top-9 mx-auto w-[76%] text-[oklch(0.92_0.14_190)] opacity-90 [filter:drop-shadow(-0.6px_0_0_oklch(0.62_0.22_25/0.5))_drop-shadow(0.6px_0_0_oklch(0.78_0.15_200/0.5))_drop-shadow(0_0_6px_currentColor)]"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {
        motif === 'roadmap' ? (
          <g>
            {/* A plan: staggered bars, a milestone diamond, a today line */}
            <g opacity="0.28" stroke-width="1">
              <path d="M4 12h112M4 32h112M4 52h112M4 72h112" />
            </g>
            <g stroke-width="7" opacity="0.9" stroke-linecap="round">
              <path d="M14 12h34" />
              <path d="M30 32h46" />
              <path d="M52 52h40" />
              <path d="M68 72h34" />
            </g>
            <g opacity="0.55" stroke-width="1.5">
              <path d="M92 4v88" stroke-dasharray="4 4" />
            </g>
            <g fill="currentColor" stroke="none" opacity="0.95">
              <path d="M92 46l6 6-6 6-6-6z" />
            </g>
          </g>
        ) : (
          <g>
            {/* An artboard: chrome bar, sidebar, blocks, a cursor */}
            <rect x="6" y="6" width="108" height="76" rx="4" stroke-width="2" opacity="0.9" />
            <path d="M6 20h108" stroke-width="2" opacity="0.9" />
            <g opacity="0.75" stroke-width="2">
              <circle cx="14" cy="13" r="2" />
              <circle cx="22" cy="13" r="2" />
              <circle cx="30" cy="13" r="2" />
            </g>
            <path d="M40 20v62" stroke-width="2" opacity="0.55" />
            <g opacity="0.5" stroke-width="4" stroke-linecap="round">
              <path d="M14 32h16M14 42h16M14 52h10" />
            </g>
            <g opacity="0.8" stroke-width="2">
              <rect x="50" y="30" width="52" height="20" rx="3" />
              <rect x="50" y="58" width="24" height="16" rx="3" />
              <rect x="80" y="58" width="22" height="16" rx="3" />
            </g>
            <g fill="currentColor" stroke="none">
              <path d="M84 44l14 12-6 1 4 8-3 2-4-8-5 4z" opacity="0.95" />
            </g>
          </g>
        )
      }
    </svg>

    <div
      class="absolute inset-0 bg-[repeating-linear-gradient(0deg,rgb(0_0_0/0.13)_0_1px,transparent_1px_3px)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="absolute inset-0 bg-linear-to-t from-black/90 via-black/45 via-52% to-black/10"
      aria-hidden="true"
    >
    </div>



    <div class="relative z-10 mt-auto p-3.5">
      <h3 class="phosphor-type text-[oklch(0.97_0.03_190)]">
        {lines.map((l) => <span class={l.cls}>{l.text}</span>)}
      </h3>

      <p class="mt-1.5 font-mono text-xs text-white/60">{parts} videos</p>
    </div>
  </article>
</a>
