---
import type { Locale } from '@/lib/i18n';
import { useTranslations } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button
  type="button"
  data-theme-toggle
  class="group relative grid h-8 w-14 shrink-0 place-items-center rounded-full border border-chassis-edge bg-linear-to-b from-chassis-hi to-chassis-lo shadow-[inset_0_1px_0_rgb(255_255_255/0.14),inset_0_-1px_2px_rgb(0_0_0/0.25)] transition-colors"
  aria-label={t('theme.toggle')}
  aria-pressed="false"
>
  <!-- The travelling slug. Reads as a physical rocker switch. -->
  <span
    data-theme-slug
    class="pointer-events-none absolute left-1 h-6 w-6 rounded-full border border-chassis-edge bg-linear-to-b from-[oklch(0.72_0.02_80)] to-[oklch(0.5_0.02_75)] shadow-[0_1px_3px_rgb(0_0_0/0.5),inset_0_1px_0_rgb(255_255_255/0.35)] transition-transform duration-200 ease-[cubic-bezier(.3,1.4,.5,1)] dark:translate-x-6 dark:from-[var(--amber-500)] dark:to-[var(--amber-700)]"
  ></span>
  <span class="sr-only" data-theme-label>{t('theme.light')}</span>
</button>

<script>
  const KEY = 'theme';

  function apply(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.setAttribute('aria-pressed', String(dark));
    }
  }

  function sync() {
    const dark = document.documentElement.classList.contains('dark');
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      btn.setAttribute('aria-pressed', String(dark));
    }
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest('[data-theme-toggle]');
    if (!btn) return;
    const next = !document.documentElement.classList.contains('dark');
    apply(next);
    try {
      localStorage.setItem(KEY, next ? 'dark' : 'light');
    } catch {
      /* private mode: the choice just will not persist */
    }
  });

  // Follow the OS only while the visitor has not chosen for themselves.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    try {
      if (localStorage.getItem(KEY)) return;
    } catch {
      /* fall through and follow the OS */
    }
    apply(e.matches);
  });

  sync();
  document.addEventListener('astro:page-load', sync);
</script>
