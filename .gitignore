# .gitignore for Yeoman-Jekyll projects

# Ignore hidden folders #
# This takes care of .tmp, .sass-cache, and many others #
.*/

node_modules/

# Ignore OS generated files #
.DS_Store*
ehthumbs.db
Thumbs.db
app/assets/js/bundle.js
app/assets/css/*
public
.jekyll-metadata

# Always-ignore files and folders #
*.diff
*.err
*.log
*.orig
*.rej
*.swn
*.swo
*.swp
*.css
._*
*~

# Ignore packages #
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Ignore for Yeoman-Jekyll projects #
app/_bower_components
dist
node_modules
.tmp
Gemfile.lock

# ── Astro (v7 rebuild) ────────────────────────────────────────────
# The Jekyll-era rules above ignore `*.css` wholesale and every dotted
# folder. Astro's stylesheets live in src/ and must be tracked, so
# re-include them explicitly. Order matters: negations come last.
!src/
!src/**/*.css
!static/
!static/**

.astro/
.vercel/
.netlify/
bun.lockb.bak
static/fonts

# Source art for the ascii pipeline — generated, large, and only needed
# to re-render. The SVG output in static/art is what ships.
art-src/
